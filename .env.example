# Database
DATABASE_URL=postgresql+psycopg://screening:screening@localhost:5432/screening

# OpenAI
OPENAI_API_KEY=sk-replace-me

# Session cookies. Leave true everywhere except local development over plain
# http: without it the session cookie travels in the clear.
COOKIE_SECURE=true

# Résumé storage
UPLOADS_DIR=uploads
MAX_UPLOAD_BYTES=10485760

# Background batch scheduler. Off unless explicitly enabled: a loop that starts
# by accident spends real money. Set to true in deployment only.
WORKER_ENABLED=false

# Outreach. Unset means sending is unavailable and the API says so, rather than
# accepting an approval and quietly dropping the message.
RESEND_API_KEY=
OUTREACH_FROM=hiring@yourcompany.com

# Where the panel lives, e.g. "panel" or "hiring-desk". Choose your own per
# deployment and never link to it publicly. This is hygiene, not security: the
# sign-in protects the panel, not the URL.
VITE_PANEL_PATH=panel
PANEL_PATH=panel

# Application
ENVIRONMENT=development

# --- Observability ---
# JSON log lines. Leave false locally; set true in any deployment where logs are
# collected, because a log nobody can grep is not observability.
LOG_JSON=false
LOG_LEVEL=INFO

# Traces are always recorded and only exported when this is set, so leaving it
# empty costs nothing and needs no collector.
OTEL_ENDPOINT=
SERVICE_NAME=verbatim-api

# /metrics answers 404 until this is set, then wants `Authorization: Bearer <it>`.
# Queue depth and spend are useful to an operator and to an attacker alike.
METRICS_TOKEN=

# Backlog past which readiness reports `degraded`. Never a 503: an instance with
# a slow queue still serves the panel.
QUEUE_WARNING_MINUTES=90
