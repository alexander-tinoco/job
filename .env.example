# Database
DATABASE_URL=postgresql+psycopg://screening:screening@localhost:5432/screening

# OpenAI
OPENAI_API_KEY=sk-replace-me

# Guards the private endpoints until real auth arrives in Phase 8.
# Empty means every private endpoint is disabled (fails closed).
ADMIN_TOKEN=dev-token-change-me

# Résumé storage
UPLOADS_DIR=uploads
MAX_UPLOAD_BYTES=10485760

# Application
ENVIRONMENT=development
