# Verbatim — every setting the API reads, with the defaults it uses when unset.
# Copy to `.env` at the repository root. `.env` is never committed.
#
# The API reads this file from the repository root, not from api/, so a relative
# ".env" started from inside api/ would silently miss it.
#
# Grouped by what breaks if you get it wrong.


# ── Required in a deployment ────────────────────────────────────────────────

# The one secret with a bill attached. Without it applications still arrive and
# are extracted, but nothing is ever evaluated — /ready reports `degraded` and
# says `model_api: unconfigured` rather than failing silently.
OPENAI_API_KEY=

DATABASE_URL=postgresql+psycopg://screening:screening@localhost:5432/screening

# Sends the session cookie only over https. **Never false in a deployment**:
# without it the credential travels in the clear. False locally only because
# compose serves plain http, where the Secure flag would stop the cookie ever
# being stored and you could not sign in at all.
COOKIE_SECURE=true

# development | production. Reported by /health and stamped on every trace.
ENVIRONMENT=development


# ── Where the panel lives ───────────────────────────────────────────────────

# The URL segment for the HR panel: https://your-host/<PANEL_PATH>.
# Choose your own per deployment and never link to it publicly.
#
# **This is not a security control.** A URL leaks through browser history,
# Referer headers, bookmarks and any chat someone pastes it into. What protects
# the panel is the sign-in: Argon2id, server-side sessions, an HttpOnly cookie
# and a lockout. The path only keeps the admin surface out of sight and out of
# search results. The front end needs the same value at build time as
# VITE_PANEL_PATH.
PANEL_PATH=panel
VITE_PANEL_PATH=panel


# ── The batch worker ────────────────────────────────────────────────────────

# The background scheduler that sends batches and collects results. Off unless
# explicitly enabled, and that is deliberate: a loop that starts by accident
# spends real money. Leave false locally; true on exactly one instance in a
# deployment.
#
# With this false, applications pile up in the queue unevaluated — which is
# what /ready reports as a stalled queue.
WORKER_ENABLED=false


# ── Résumé storage ──────────────────────────────────────────────────────────

# A root; files land under {UPLOADS_DIR}/{application_id}/ with unguessable
# names, outside any statically served path.
UPLOADS_DIR=uploads

# 10 MB. Anything larger is refused with 413 before it is written.
MAX_UPLOAD_BYTES=10485760


# ── Outreach email ──────────────────────────────────────────────────────────

# Resend. Unset means sending is unavailable and the API answers 503, rather
# than accepting an approval and quietly dropping the message.
RESEND_API_KEY=
OUTREACH_FROM=


# ── Observability ───────────────────────────────────────────────────────────

# One JSON object per log line, with a correlation id and one canonical line
# per request. Leave false locally for readable text; true anywhere logs are
# collected, because a log nobody can grep is not observability.
LOG_JSON=false
LOG_LEVEL=INFO

# Where to ship traces, as an OTLP **HTTP** endpoint ending in /v1/traces.
# Spans are always recorded and only exported when this is set, so leaving it
# empty costs the price of building a span, needs no collector, and is the
# right setting until you actually want to look at one.
#
# To look at one, the stack ships a trace viewer behind a compose profile:
#
#   OTEL_ENDPOINT=http://jaeger:4318/v1/traces docker compose --profile tracing up -d
#
# then open http://localhost:16686. `jaeger` is the service name inside the
# compose network — from your own shell the same collector is localhost:4318.
# Storage is in memory, so restarting the container discards every trace.
#
#   compose Jaeger   http://jaeger:4318/v1/traces
#   Jaeger elsewhere http://localhost:4318/v1/traces
#   Grafana Cloud    https://otlp-gateway-<zone>.grafana.net/otlp/v1/traces
OTEL_ENDPOINT=

# The name this service appears under in a trace viewer.
SERVICE_NAME=verbatim-api

# /metrics answers 404 until this is set, then requires
# `Authorization: Bearer <this>`. Queue depth and spend tell an operator what is
# happening and tell an attacker when nobody is looking, so it fails closed.
METRICS_TOKEN=

# Backlog age, in minutes, past which /ready reports `degraded`. Never a 503: an
# instance with a slow queue still serves every page in the panel.
QUEUE_WARNING_MINUTES=90
